{
  "name": "sequelizr",
  "version": "4.0.4",
  "description": "Manage Sequelize models",
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run build:test && npm run test:unit:run",
    "test:unit:run": "node --test dist-test/test/unit",
    "test:cover": "npm run build:test && node --experimental-test-coverage --test-coverage-include=dist-test/src/**/*.js --test dist-test/test/unit",
    "test:integration": "npm run build:test && npm run test:integration:run",
    "test:integration:run": "node --test --test-concurrency=1 dist-test/test/integration",
    "test:mysql": "cross-env DIALECT=mysql npm run test:integration",
    "test:mssql": "cross-env DIALECT=mssql npm run test:integration",
    "test:all-dialects": "npm run test:mysql && npm run test:mssql",
    "lint": "eslint",
    "format": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UziTech/sequelizr.git"
  },
  "bin": "./dist/bin/sequelizr.js",
  "keywords": [
    "sequelize",
    "model",
    "models",
    "sync",
    "create",
    "download",
    "upload"
  ],
  "author": "Tony Brix",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UziTech/sequelizr/issues"
  },
  "homepage": "https://github.com/UziTech/sequelizr#readme",
  "dependencies": {
    "sequelize": "^6.37.8",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.5",
    "@types/sequelize": "^6.12.0",
    "@types/yargs": "^17.0.35",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "mysql2": "3.24.4",
    "semantic-release": "^25.0.9",
    "tedious": "^20.0.0",
    "tmp-promise": "^3.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  }
}
